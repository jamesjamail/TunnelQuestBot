generator client {
  provider     = "prisma-client"
  output       = "./generated"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  discordUserId   String    @id @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  discordUsername String
  snoozedUntil    DateTime?

  watches               Watch[]
  blockedPlayersByWatch BlockedPlayerByWatch[]
  blockedPlayers        BlockedPlayer[]
  blockedTraders        BlockedTrader[]
  hiddenTraders         HiddenTrader[]
  linkedPlayers         PlayerLink[]
}

enum Server {
  BLUE
  GREEN
  RED
}

enum WatchType {
  WTS
  WTB
}

model Watch {
  id                    Int       @id @default(autoincrement())
  discordUserId         String
  server                Server
  watchType             WatchType
  itemName              String
  priceRequirement      Int?
  created               DateTime  @default(now())
  active                Boolean   @default(true)
  snoozedUntil          DateTime?
  notes                 String?
  // allow other discord users to contact regarding item; on by default for new
  // watches, opt out with marketplace:false. Watches that predate marketplace
  // matching were pinned to false by the migration and stay out until opted in
  isPublicallyTradeable Boolean   @default(true)

  user             User                   @relation(fields: [discordUserId], references: [discordUserId])
  blockedWatches   BlockedPlayerByWatch[]
  marketplaceAsWtb MarketplaceMatch[]     @relation("MarketplaceMatchWtbWatch")
  marketplaceAsWts MarketplaceMatch[]     @relation("MarketplaceMatchWtsWatch")

  @@unique([discordUserId, itemName, server, watchType])
  @@index([active])
}

// A standing pairing between an opted-in WTB watch and an opted-in WTS watch
// for the same item/server, once both sides exist and their prices don't
// conflict. Recorded once and notified to both sides at most once each.
model MarketplaceMatch {
  id            Int       @id @default(autoincrement())
  wtbWatchId    Int
  wtsWatchId    Int
  server        Server
  itemName      String
  createdAt     DateTime  @default(now())
  wtbNotifiedAt DateTime?
  wtsNotifiedAt DateTime?

  wtbWatch Watch @relation("MarketplaceMatchWtbWatch", fields: [wtbWatchId], references: [id], onDelete: Cascade)
  wtsWatch Watch @relation("MarketplaceMatchWtsWatch", fields: [wtsWatchId], references: [id], onDelete: Cascade)

  @@unique([wtbWatchId, wtsWatchId])
  @@index([itemName, server])
}

model BlockedPlayerByWatch {
  id            Int    @id @default(autoincrement())
  discordUserId String
  watchId       Int
  player        String
  watch         Watch  @relation(fields: [watchId], references: [id], onDelete: Cascade)
  user          User   @relation(fields: [discordUserId], references: [discordUserId])

  @@unique([watchId, player])
  @@index([discordUserId])
}

model BlockedPlayer {
  id            Int     @id @default(autoincrement())
  discordUserId String
  server        Server
  player        String
  active        Boolean @default(true)

  user User @relation(fields: [discordUserId], references: [discordUserId])

  @@unique([discordUserId, server, player])
}

// Keyed on discord user, not in-game character: marketplace matching pairs
// discord users, and most have no linked characters to bridge the two. The
// blocked user needs no User row (they may never have made a watch), so
// blockedDiscordUserId is a plain id rather than a relation. Matching treats
// a block as mutual - see filterOutBlockedPairs.
model BlockedTrader {
  id                   Int      @id @default(autoincrement())
  discordUserId        String
  blockedDiscordUserId String
  createdAt            DateTime @default(now())

  user User @relation(fields: [discordUserId], references: [discordUserId])

  @@unique([discordUserId, blockedDiscordUserId])
  @@index([blockedDiscordUserId])
}

// A one-way dismissal, unlike BlockedTrader: the hidden trader stays matched
// and can still see and contact the user. It only filters what the user is
// shown and DMed, and is applied when matches are read, never when they are
// recorded.
model HiddenTrader {
  id                  Int      @id @default(autoincrement())
  discordUserId       String
  hiddenDiscordUserId String
  createdAt           DateTime @default(now())

  user User @relation(fields: [discordUserId], references: [discordUserId])

  @@unique([discordUserId, hiddenDiscordUserId])
}

model PlayerLink {
  id             Int       @id @default(autoincrement())
  discordUserId  String
  server         Server?
  player         String?
  linkCode       String?
  linkCodeExpiry DateTime?

  user User @relation(fields: [discordUserId], references: [discordUserId])

  @@unique([server, player])
  @@index([server, player])
}

// Records a completed import in the same transaction as the imported rows.
model DataMigration {
  name        String   @id
  completedAt DateTime @default(now())
  counts      String
}
