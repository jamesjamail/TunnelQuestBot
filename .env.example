# Copy this file to `.env`, then fill in the values below.
#
# `npm run doctor` checks this file and tells you exactly what is missing or
# malformed, so run it whenever something will not start.
#
# For host-based development (`npm run dev`) you only need the Discord section.
# DATABASE_URL, REDIS_URL and FAKE_LOGS are supplied by the dev script.

######################
### Discord config ###
######################

# From https://discord.com/developers/applications -> your app -> Bot -> Token
TOKEN=

# Same page, "Application ID"
CLIENT_ID=

# Channel IDs. Enable Developer Mode in Discord (Settings -> Advanced), then
# right-click a channel and "Copy Channel ID".
#
# `npm run setup` creates all of these in a guild and fills them in for you.

# Classic stream channel IDs
SERVERS_BLUE_STREAM_CHANNEL_CLASSIC_ID=
SERVERS_GREEN_STREAM_CHANNEL_CLASSIC_ID=
SERVERS_RED_STREAM_CHANNEL_CLASSIC_ID=

# Embedded stream channel IDs
SERVERS_GREEN_STREAM_CHANNEL_EMBEDDED_ID=
SERVERS_BLUE_STREAM_CHANNEL_EMBEDDED_ID=
SERVERS_RED_STREAM_CHANNEL_EMBEDDED_ID=

# Other discord channel IDs
COMMAND_CHANNEL=
FEEDBACK_AND_IDEAS_CHANNEL=
ERROR_LOG_CHANNEL_ID=

######################
### General config ###
######################

WATCH_DURATION_IN_DAYS=7
IMAGE_BUCKET_URL=https://p99-item-thumbnails.s3.amazonaws.com
WIKI_BASE_URL=https://wiki.project1999.com

# For avg price data on items (not relevant for all everquest servers)
HISTORICAL_AUCTION_DATA_API=https://pigparse.azurewebsites.net

######################
### Logfile config ###
######################

# Only needed when tailing real EverQuest logs, which means running the full
# container stack against a machine that has the game installed. `npm run dev`
# sets FAKE_LOGS=true and generates auction lines instead, so you can develop
# without an EverQuest client.

# Example 1: "C:\EverQuest\Logs" -> "//c/everquest/logs" (capitalization is not relevant)
# Example 2: "C:\EverQuest\Logs" -> "C:\\everquest\\logs\\" (double slashes and trailing slash REQUIRED)
# Empty local directory for fake logs or headless collectors. When reading
# EverQuest client logs, replace this with their actual directory.
LOG_SOURCE_PATH=./logs

# Name of log files (not including path, specify that above)
SERVERS_BLUE_LOG_FILE=eqlog_Mychar_project1999.txt
SERVERS_GREEN_LOG_FILE=eqlog_Mychar_P1999Green.txt
SERVERS_RED_LOG_FILE=eqlog_Mychar_P1999PVP.txt

# Generate fake log lines instead of tailing real ones, so you can develop
# without an EverQuest client. This defaults to on: the LOG_SOURCE_PATH and
# SERVERS_*_LOG_FILE values above are placeholders, and tailing them would fail.
# Set it to false only once those point at a real EverQuest install.
FAKE_LOGS=true

# Optional headless P99 collectors. Copy the example JSON files under
# p99-logger/, set these paths, and start Compose with --profile p99-loggers.
# SERVERS_BLUE_LOG_FILE_PATH=/p99-logger/blue/chat.jsonl
# SERVERS_GREEN_LOG_FILE_PATH=/p99-logger/green/chat.jsonl
# SERVERS_RED_LOG_FILE_PATH=/p99-logger/red/chat.log
P99_LOGGER_IMAGE=ghcr.io/rm-you/p99-logger-client:sha-fbb036a
P99_BLUE_CONFIG_FILE=./p99-logger/blue.json
P99_GREEN_CONFIG_FILE=./p99-logger/green.json
# Replace these with the output of `id -u` and `id -g` on Linux.
P99_UID=1000
P99_GID=1000
# The active JSONL file rotates in place at this size. Rotated copies are
# compressed, and the collector/bot keep using the same active file path.
# Size: positive whole number plus k, K, M, or G. Interval: positive seconds.
P99_JSONL_MAX_SIZE=100M
P99_JSONL_ROTATE_COUNT=5
P99_JSONL_ROTATE_INTERVAL_SECONDS=300

# Bound stdout/stderr retained by Docker for every Compose service.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

####################################
### DO NOT TOUCH BELOW THIS LINE ###
####################################

# Run node.js in debug mode (for remote debugging)
DEBUG_MODE=false

# Redis Socket location
REDIS_SOCKET_DIR="/redis_socket"

# Database Socket location
DB_SOCKET_DIR="/dbsocket"

# Database Config
POSTGRES_USER="tunnelquestbot"
POSTGRES_PASSWORD="tunn3lb0tp4ss"
POSTGRES_DB="tunnelquestbot"

# The container stack talks to Postgres over a unix socket shared through a
# docker volume. `npm run dev` overrides this with a localhost TCP URL, because
# the bot is running on the host rather than in the container. Only this exact
# template with DB_SOCKET_DIR=/dbsocket is translated; custom URLs and socket
# directories are preserved, including their database name and credentials.
DATABASE_URL = 'postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost/${POSTGRES_DB}?host=${DB_SOCKET_DIR}'
