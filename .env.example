# Copy to .env, fill secrets/channel IDs, then run: ./manage.sh doctor

######################
### Discord config ###
######################

TOKEN=
CLIENT_ID=

COMMAND_CHANNEL=
FEEDBACK_AND_IDEAS_CHANNEL=
ERROR_LOG_CHANNEL_ID=

# A server is enabled only when both of its stream channel IDs are set.
# Leave both blank to disable that server.
SERVERS_BLUE_STREAM_CHANNEL_CLASSIC_ID=
SERVERS_BLUE_STREAM_CHANNEL_EMBEDDED_ID=
SERVERS_GREEN_STREAM_CHANNEL_CLASSIC_ID=
SERVERS_GREEN_STREAM_CHANNEL_EMBEDDED_ID=
SERVERS_RED_STREAM_CHANNEL_CLASSIC_ID=
SERVERS_RED_STREAM_CHANNEL_EMBEDDED_ID=

######################
### Auction inputs ###
######################

FAKE_LOGS=false
LOG_SOURCE_PATH=./logs

# Green and Blue use the bundled headless collectors. A server with blank
# channel IDs remains disabled even though its collector path is prefilled.
SERVERS_BLUE_LOG_FILE_PATH=/p99-logger/blue/chat.jsonl
SERVERS_GREEN_LOG_FILE_PATH=/p99-logger/green/chat.jsonl
SERVERS_RED_LOG_FILE_PATH=/p99-logger/red/chat.jsonl

P99_LOGGER_IMAGE=ghcr.io/rm-you/p99-logger-client:sha-e47b297
# Optional per-server overrides when a collector needs a different image
# (for example Quarm on Red). Leave blank to use P99_LOGGER_IMAGE.
P99_BLUE_LOGGER_IMAGE=
P99_GREEN_LOGGER_IMAGE=
P99_RED_LOGGER_IMAGE=
P99_BLUE_CONFIG_FILE=./p99-logger/blue.json
P99_GREEN_CONFIG_FILE=./p99-logger/green.json
P99_RED_CONFIG_FILE=./p99-logger/red.json
# Set these to the output of `id -u` and `id -g`.
# Collector JSON files must be mode 600 and owned by this UID.
P99_UID=
P99_GID=

P99_JSONL_MAX_SIZE=100M
P99_JSONL_ROTATE_COUNT=5
P99_JSONL_ROTATE_INTERVAL_SECONDS=300

######################
### General config ###
######################

WATCH_DURATION_IN_DAYS=7
IMAGE_BUCKET_URL=https://p99-item-thumbnails.s3.amazonaws.com
WIKI_BASE_URL=https://wiki.project1999.com
HISTORICAL_AUCTION_DATA_API=https://pigparse.azurewebsites.net

DATABASE_URL=file:./data/tunnelquestbot.db
REDIS_SOCKET_DIR=/redis_socket
DEBUG_MODE=false

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
