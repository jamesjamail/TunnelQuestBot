# Ignore everything
*

# But not these files...
!.gitignore
!.gitattributes
!.dockerignore
!.env.example
!*.sh
!*.yml
!README.md
!OPERATOR.md
!AGENTS.md
!/tests/
!/tests/*.sh
!/p99-logger/
!/p99-logger/*.example.json
!/p99-logger/*.Dockerfile
!/p99-logger/*.sh
!/metabase/
!/metabase/*.sh
!/.github/
!/.github/workflows/
!/.github/workflows/deployment.yml
!/.cursor/
!/.cursor/skills/
!/.cursor/skills/*/
!/.cursor/skills/*/SKILL.md
!/.cursor/skills/*/reference.md
!/.claude/
!/.claude/skills/
!/.claude/skills/*/
!/.claude/skills/*/SKILL.md
!/.claude/skills/*/reference.md
