node_modules
build
coverage
src/prisma/generated
.env
#	`.vscode/*` rather than `.vscode`: excluding the directory itself stops git
#	descending into it, and the negations below are then silently ignored.
.vscode/*
#	Two exceptions, shared on purpose: extensions.json recommends the Biome
#	extension, settings.json points the editor at it and turns on format-on-save.
#	Together they mean a contributor matches CI without configuring anything.
#	Everything else under .vscode/ stays personal.
!.vscode/extensions.json
!.vscode/settings.json
.idea
.claude

# Local P99 login credentials and collected chat logs
/logs/
p99-logger/*.json
!p99-logger/*.example.json
p99-logger/data/
