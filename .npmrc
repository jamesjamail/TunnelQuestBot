#	Fail the install when the Node version is wrong, rather than letting it
#	surface much later as something unrecognisable. Without this, Node 20 gets
#	through `npm ci` and then dies inside testcontainers with
#	"webidl.util.markAsUncloneable is not a function", which says nothing about
#	the actual problem. `engines` in package.json is advisory on its own.
engine-strict=true
