{
  "name": "tunnel-quest-bot",
  "version": "1.2.3",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "start": "node ./build/index.js",
    "doctor": "node ./build/doctor.js",
    "debug": "node --inspect=0.0.0.0 ./build/index.js",
    "prepare": "husky",
    "postinstall": "node ./scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "biome format",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "dev": "node ./scripts/dev.mjs",
    "clean": "node -e \"fs.rmSync('build', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "dev:deps": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis",
    "dev:deps:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "setup": "node ./scripts/setup.mjs"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "keywords": [],
  "author": "jamesjamail",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@discordjs/rest": "^2.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ahocorasick": "^1.0.2",
    "chalk": "^5.6.2",
    "date-fns": "^4.1.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^13.0.0",
    "fuse.js": "^7.1.0",
    "ioredis": "^5.3.2",
    "prisma": "^7.9.1",
    "tail": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^25.0.10",
    "@types/tail": "^2.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
